DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require&channel_binding=require
PORT=5000
JWT_SECRET=your_jwt_secret_here

CHROMA_URL=http://chroma:8000
OLLAMA_URL=http://host.docker.internal:11434/api/chat

# URL untuk server model lokal (sesuaikan dengan server yang Anda jalankan)
# Contoh default kompatibel dengan Ollama: http://host.docker.internal:11434/api/chat
MODEL_API_URL=http://host.docker.internal:11434/api/chat
# Nama model yang akan dipanggil pada server model (jika server memerlukan nama model)
MODEL_NAME=dolphin-llama3

CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_id_here
CHROMA_DATABASE=your_chroma_database_name_here
# Environment Configuration for Bank Jateng Web App

# API Configuration
VITE_API_BASE_URL=http://localhost:3000/api

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Apple ID OAuth
VITE_APPLE_TEAM_ID=your_apple_team_id_here

# Feature Flags
VITE_ENABLE_CHATBOT=true
VITE_ENABLE_2FA=true
VITE_ENABLE_NOTIFICATIONS=true

# Endpoints
VITE_AUTH_ENDPOINT=/auth
VITE_ACCOUNTS_ENDPOINT=/accounts
VITE_TRANSACTIONS_ENDPOINT=/transactions
VITE_CHATBOT_ENDPOINT=/chatbot
VITE_NOTIFICATIONS_ENDPOINT=/notifications

# App Configuration
VITE_APP_NAME=Bank Jateng
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=development

# Logging
VITE_LOG_LEVEL=debug
VITE_ENABLE_LOGGING=true
